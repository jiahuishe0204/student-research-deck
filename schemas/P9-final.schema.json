{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["delivery_version", "evidence_version", "final_report", "final_ppt", "verification_note", "open_issues", "source_ids", "evidence_ids", "change_log"],
  "properties": {
    "delivery_version": {"type": "string", "minLength": 1},
    "evidence_version": {"type": "string", "minLength": 1},
    "final_report": {
      "type": "object",
      "required": ["title", "markdown", "used_evidence_ids"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "markdown": {"type": "string", "minLength": 1},
        "used_evidence_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "final_ppt": {
      "type": "object",
      "required": ["deck_title", "storyline", "pages"],
      "properties": {
        "deck_title": {"type": "string", "minLength": 1},
        "storyline": {"type": "string", "minLength": 1},
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["page_id", "title", "purpose", "on_slide_text", "visual_suggestion", "speaker_notes", "evidence_ids", "figure_refs", "source_citations"],
            "properties": {
              "page_id": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "purpose": {"type": "string"},
              "on_slide_text": {"type": "array", "items": {"type": "string"}},
              "visual_suggestion": {"type": "string"},
              "speaker_notes": {"type": "string"},
              "evidence_ids": {"type": "array", "items": {"type": "string"}},
              "figure_refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["figure_id", "source_id", "locator", "intended_use", "reuse_status"],
                  "properties": {
                    "figure_id": {"type": "string"},
                    "source_id": {"type": "string"},
                    "locator": {"type": "string"},
                    "intended_use": {"type": "string"},
                    "reuse_status": {"enum": ["allowed", "citation_only", "permission_required", "unknown"]}
                  },
                  "additionalProperties": false
                }
              },
              "source_citations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["source_id", "short_vancouver"],
                  "properties": {
                    "source_id": {"type": "string"},
                    "short_vancouver": {"type": "string"}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "verification_note": {"type": "string", "minLength": 1},
    "open_issues": {"type": "array", "items": {"type": "string"}},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "change_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "action", "reason"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "action": {"enum": ["kept", "revised", "removed", "marked_unverified"]},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
