{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["domain","normalized_topic","scope_hint","tier","assumptions","topic_breadth","direction_options","need_clarification","clarification_question","confirmation_text"],
  "properties":{
    "domain":{"type":"string"},"normalized_topic":{"type":"string","minLength":1},"scope_hint":{"type":"string"},
    "tier":{"enum":["fast","deep"]},"assumptions":{"type":"array","items":{"type":"string"}},
    "topic_breadth":{"enum":["focused","broad","ambiguous","out_of_scope"]},
    "direction_options":{"type":"array","maxItems":4,"items":{"type":"object","required":["direction_id","title","focus"],"properties":{"direction_id":{"type":"string","minLength":1},"title":{"type":"string","minLength":2},"focus":{"type":"string","minLength":4}},"additionalProperties":false}},
    "need_clarification":{"type":"boolean"},"clarification_question":{"type":["string","null"]},"confirmation_text":{"type":["string","null"]}
  },
  "additionalProperties":false
}
